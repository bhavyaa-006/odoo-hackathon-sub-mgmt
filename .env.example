DATABASE_URL=postgresql+psycopg2://brightloop:change-me@localhost:5432/brightloop
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Run Alembic in production, then keep automatic schema creation disabled.
AUTO_CREATE_SCHEMA=false

# Docker Compose development defaults (change all values outside local development).
POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop-dev-password
POSTGRES_PORT=5432
API_PORT=8000
