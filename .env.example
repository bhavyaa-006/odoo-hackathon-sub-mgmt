# PostgreSQL Settings
POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=oddo
POSTGRES_PORT=5433

# API Backend Settings
API_PORT=8000
DATABASE_URL=postgresql://brightloop:oddo@localhost:5433/brightloop
JWT_SECRET=brightloop-super-secure-jwt-secret-key-production-ready
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTO_CREATE_SCHEMA=true

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false
VITE_USE_MOCK_AUTH=false
