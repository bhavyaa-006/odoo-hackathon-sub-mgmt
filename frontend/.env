# Brightloop API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Explicit Frontend Mock Mode
# Set to 'true' to run and preview the complete Customer Area with rich mock data
# without requiring a running backend.
# Set to 'false' to connect to the real FastAPI backend.
VITE_USE_MOCK_API=true
VITE_USE_MOCK_AUTH=true

# Demo Test Accounts (Mock Mode):
# Customer: customer@brightloop.io / Password123!
# Staff:    staff@brightloop.io    / Password123!
# Admin:    admin@brightloop.io    / Password123!
