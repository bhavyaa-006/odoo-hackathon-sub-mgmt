# Brightloop API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Explicit Frontend Mock Mode Configuration
# -------------------------------------------------------------
# Set VITE_USE_MOCK_API=true to run the frontend independently with
# simulated customer data, realistic latency, and interactive mutations.
#
# Set VITE_USE_MOCK_API=false to route all requests to the live FastAPI backend.
VITE_USE_MOCK_API=false
VITE_USE_MOCK_AUTH=false

# Sample Mock Credentials:
# Customer: customer@brightloop.io / Password123!
# Staff:    staff@brightloop.io    / Password123!
# Admin:    admin@brightloop.io    / Password123!
